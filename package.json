{
  "name": "cooper-os",
  "version": "10.3.2",
  "description": "COOPER OS 个人总控台",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.cooper.os",
    "productName": "COOPER OS",
    "files": [
      "main.js",
      "index.html",
      "manifest.json",
      "sw.js",
      "icon-512.png",
      "icon-192.png",
      "server.js",
      "snow_peaks_v6.png"
    ],
    "win": {
      "target": "portable",
      "icon": "icon-512.png"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}